{
	"schemaVersion": 1,
	"id": "manageenchantment",
	"version": "${version}",
	"name": "ManageEnchantment",
	"description": "Allows all enchantments to exceed their vanilla maximum level with configurable per-enchantment and global multiplier settings. Removes anvil level caps.",
	"authors": [
		"useReducer"
	],
	"contact": {},
	"license": "CC0-1.0",
	"icon": "assets/manageenchantment/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"org.useReducer.ManageEnchantment"
		],
		"client": [
			"org.useReducer.client.ManageEnchantmentClient"
		],
		"modmenu": [
			"org.useReducer.client.ManageEnchantmentModMenu"
		]
	},
	"mixins": [
		"manageenchantment.mixins.json",
		{
			"config": "manageenchantment.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"cloth-config": ">=21.11.153",
		"modmenu": ">=17.0.0"
	}
